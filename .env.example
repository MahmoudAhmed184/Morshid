POSTGRES_DB=morshid
POSTGRES_USER=morshid
POSTGRES_PASSWORD=morshid_local_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# The app Compose profile injects PDF_STORAGE_PATH=/workspace/storage/pdfs and
# mounts the named PDF volume there. Host-run NestJS uses server/.env instead.
# Gemini settings intentionally are not forwarded into the production Compose
# server profile. See server/.env.example for the restricted host-run demo.

# Gemini is not selectable through Compose: the server profile pins
# NODE_ENV=production, and the server rejects COMPLETION_PROVIDER=gemini there
# because free-tier inputs AND outputs may be reviewed and used to improve
# Google's products, so that provider must never serve real users. The
# acknowledgement below is therefore kept false here and is documented only so
# the variable is discoverable; the host-run demo sets it in the git-ignored
# server/.env. Setting it to true states that you accept that free-tier prompts
# and completions may be used to improve Google's products, and that only
# synthetic, permission-safe data will be sent. See
# docs/research/gemini-free-tier-quotas-2026-07-23.md.
GEMINI_DEMO_ACKNOWLEDGED=false

# Completion stays deterministic unless explicitly selected. Blank key/model
# values are intentional; put live values only in an untracked .env file.
# ITI_BEDROCK_ALLOW_INSECURE_HTTP accepts only true, false, or blank, and blank
# is read as false. AWS_BEDROCK_MAX_TOKENS must be 256-4096 whatever the
# provider; see server/.env.example for the transport/model-policy split.
COMPLETION_PROVIDER=deterministic
COMPLETION_TIMEOUT_MS=30000
ITI_BEDROCK_GATEWAY_BASE_URL=https://apiaccess.iti.net.eg/api/v1
ITI_BEDROCK_GATEWAY_API_KEY=
ITI_BEDROCK_ALLOW_INSECURE_HTTP=false
AWS_BEDROCK_MODEL_ID=
AWS_BEDROCK_ALLOWED_MODEL_IDS=
AWS_BEDROCK_MAX_TOKENS=1024

# Placeholder-only app-profile secrets. Replace both with different random
# values of at least 32 characters before using the Compose server runtime.
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_TOKEN_HASH_SECRET=replace-with-a-different-32-char-secret
