POSTGRES_DB=morshid
POSTGRES_USER=morshid
POSTGRES_PASSWORD=morshid_local_password
POSTGRES_PORT=5432
REDIS_PORT=6379
TUTORING_REQUEST_TIMEOUT_MS=120000

# The app Compose profile injects PDF_STORAGE_PATH=/workspace/storage/pdfs and
# mounts the named PDF volume there. Host-run NestJS uses server/.env instead.
# Embedding stays deterministic through Compose: it is keyless and offline, and
# the Compose server profile pins NODE_ENV=production. The three deadlines below
# split an interactive query from a whole PDF ingest and from one upstream
# sub-request; see server/.env.example for why one value cannot serve all three.
# Gemini embedding is not selectable through Compose: the server profile pins
# NODE_ENV=production and the server rejects EMBEDDING_PROVIDER=gemini there,
# because free-tier inputs may be used to improve Google's products and course
# material is not ours to donate. See server/.env.example for the host-run demo.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_QUERY_TIMEOUT_MS=10000
EMBEDDING_DOCUMENT_TIMEOUT_MS=120000
EMBEDDING_REQUEST_TIMEOUT_MS=30000

# Phase 3-5 Socratic runtime roles. Compose forwards each role independently
# and production requires all three to use live OpenAI-compatible adapters.
# Replace the example endpoint/model values with the deployment's gateway and
# keep live keys only in the untracked .env file.
ANALYSIS_MODEL_PROVIDER=openai-compatible
ANALYSIS_MODEL_BASE_URL=http://localhost:8000/v1
ANALYSIS_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct
ANALYSIS_MODEL_API_KEY=
ANALYSIS_MODEL_TIMEOUT_MS=30000
ANALYSIS_MODEL_MAX_COMPLETION_TOKENS=768
ANALYSIS_CONFIDENCE_THRESHOLD=0.6
ANALYSIS_MODEL_MAX_RETRIES=1

TUTOR_MODEL_PROVIDER=openai-compatible
TUTOR_MODEL_BASE_URL=http://localhost:8000/v1
TUTOR_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
TUTOR_MODEL_API_KEY=
TUTOR_MODEL_TIMEOUT_MS=30000
TUTOR_MODEL_MAX_COMPLETION_TOKENS=768
TUTOR_MODEL_MAX_INFRASTRUCTURE_RETRIES=1

SEMANTIC_GUARD_PROVIDER=openai-compatible
SEMANTIC_GUARD_BASE_URL=http://localhost:8000/v1
SEMANTIC_GUARD_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-Guard
SEMANTIC_GUARD_API_KEY=
SEMANTIC_GUARD_TIMEOUT_MS=30000
SEMANTIC_GUARD_MAX_COMPLETION_TOKENS=256

# Placeholder-only app-profile secrets. Replace both with different random
# values of at least 32 characters before using the Compose server runtime.
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_TOKEN_HASH_SECRET=replace-with-a-different-32-char-secret
