NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://morshid:morshid_local_password@localhost:5432/morshid
REDIS_URL=redis://localhost:6379

# Required host-run storage root. From the server workspace this resolves to
# the repository's git-ignored storage/pdfs directory.
PDF_STORAGE_PATH=../storage/pdfs

# Maximum accepted multipart PDF size in bytes. Values may be lowered; the
# validated operational ceiling and default are 10485760 / 10 MiB.
PDF_MAX_UPLOAD_BYTES=10485760

# Embedding provider selection. `deterministic` is the only supported value in
# P0: it derives stable 1,536-dimension vectors locally and needs no API key
# or network access, so it is safe for CI, local work, and the backup demo.
EMBEDDING_PROVIDER=deterministic

# Three embedding deadlines, because one value cannot serve both callers. The
# query budget bounds a single interactive chat turn and must fail fast; the
# document budget bounds a whole PDF ingest, which legitimately spans many
# upstream sub-requests; the request budget bounds one of those sub-requests and
# is further capped by whatever remains of the whole-call budget, so the last
# request of a long ingest cannot outlive the ingest's own deadline. Ceilings
# are 60000 / 900000 / 120000 ms.
EMBEDDING_QUERY_TIMEOUT_MS=10000
EMBEDDING_DOCUMENT_TIMEOUT_MS=120000
EMBEDDING_REQUEST_TIMEOUT_MS=30000

# Restricted Gemini embedding demo. Selecting `gemini` here is barred when
# NODE_ENV=production and additionally requires the acknowledgement below —
# Morshid's own free-tier data-governance policy, not an API constraint: the
# free tier lets Google use submitted inputs to improve its products, and course
# material is not ours to donate. Only synthetic, permission-safe material may
# be embedded through it.
#
# The key MUST be distinct from GEMINI_API_KEY and MUST live under a separate
# Google Cloud project: Gemini rate limits are per project, so a shared key
# would let one PDF ingest starve student chat. The schema can only prove the
# keys differ; project separation is on you.
#
# There is no GEMINI_EMBEDDING_MODEL. The model is part of the persisted
# document profile, so it is pinned in code (`gemini-embedding-2`, 1536
# dimensions); changing it requires a new profile and a full re-embed.
GEMINI_EMBEDDING_DEMO_ACKNOWLEDGED=false
GEMINI_EMBEDDING_API_KEY=

# An opaque deployment label, NOT the real Google project name. Every replica on
# one Google project must share this label so they share one budget; a
# credential rotation must never change it, or the rotation would mint a fresh
# day and 30-day window. Lowercase letters, digits, and dashes; 3+ characters.
GEMINI_EMBEDDING_QUOTA_PROJECT_ID=

# Local admission-control caps informed by the project's published Gemini
# limits. They do NOT reproduce Google's enforcement: Google's requests-per-day
# resets at midnight Pacific while this guard's day window is epoch-aligned UTC
# (7-8 hours earlier), the minute dimensions are token buckets rather than
# Google's undisclosed algorithm, and the hourly and 30-day caps are entirely
# Morshid-owned policy with no provider counterpart. Provider-side
# 429 RESOURCE_EXHAUSTED responses remain authoritative.
#
# INPUT_TOKENS_PER_MINUTE keeps its name because it maps to the upstream
# constraint conceptually, but the value metered against it is an estimate of
# UTF-8 bytes of the final formatted input — never an actual token count.
# Provider-informed:
GEMINI_EMBEDDING_REQUESTS_PER_MINUTE=
GEMINI_EMBEDDING_INPUT_TOKENS_PER_MINUTE=
GEMINI_EMBEDDING_REQUESTS_PER_DAY=
# Morshid policy:
GEMINI_EMBEDDING_LOCAL_REQUESTS_PER_HOUR=
GEMINI_EMBEDDING_LOCAL_REQUESTS_PER_30_DAYS=

# Completion provider selection and deadline. The committed default remains
# deterministic, keyless, and offline, and is what production, CI, and normal
# tests use. Select `aws-bedrock` explicitly only after rotating the ITI key and
# placing the new value in the git-ignored server/.env. `gemini` is rejected
# when NODE_ENV=production and additionally requires GEMINI_DEMO_ACKNOWLEDGED,
# and must only ever receive permission-safe, synthetic data. The timeout must
# be 1-120000 ms; local live testing may explicitly raise it to 60000 ms.
COMPLETION_PROVIDER=deterministic
COMPLETION_TIMEOUT_MS=30000

# Educational Analysis model selection. This is intentionally separate from
# COMPLETION_PROVIDER because analysis, tutoring, guarding, and embedding are
# distinct model roles. The default is deterministic, keyless, and offline for
# CI/local work. Select `openai-compatible` to call a provider exposing the
# OpenAI-compatible /chat/completions API, such as local vLLM or Google AI
# Studio's Gemini endpoint. Local vLLM can be keyless; set
# ANALYSIS_MODEL_API_KEY only when the serving gateway requires a bearer token.
# Gemini local example:
# ANALYSIS_MODEL_PROVIDER=openai-compatible
# ANALYSIS_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ANALYSIS_MODEL_NAME=gemini-3.5-flash
# ANALYSIS_MODEL_API_KEY=<GEMINI_API_KEY>
ANALYSIS_MODEL_PROVIDER=deterministic
ANALYSIS_MODEL_BASE_URL=http://localhost:8000/v1
ANALYSIS_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct
ANALYSIS_MODEL_API_KEY=
ANALYSIS_MODEL_TIMEOUT_MS=30000
ANALYSIS_CONFIDENCE_THRESHOLD=0.6
ANALYSIS_MODEL_MAX_RETRIES=1

# Tutor Generation model selection. This role is configured independently from
# Educational Analysis so tutor candidates cannot accidentally reuse analysis
# model identity or metadata. Select `openai-compatible` only for a separately
# configured tutor model served through the OpenAI-compatible /chat/completions
# API.
# Gemini local example:
# TUTOR_MODEL_PROVIDER=openai-compatible
# TUTOR_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# TUTOR_MODEL_NAME=gemini-3.6-flash
# TUTOR_MODEL_API_KEY=<GEMINI_API_KEY>
TUTOR_MODEL_PROVIDER=deterministic
TUTOR_MODEL_BASE_URL=http://localhost:8000/v1
TUTOR_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
TUTOR_MODEL_API_KEY=
TUTOR_MODEL_TIMEOUT_MS=30000
TUTOR_MODEL_MAX_INFRASTRUCTURE_RETRIES=1

# Semantic Guard model selection. This role is configured independently from
# Educational Analysis and Tutor Generation so safety validation cannot alias
# either production model identifier. The deterministic default remains the
# offline CI/local path; select `openai-compatible` only for a guard model
# served through the OpenAI-compatible /chat/completions API.
# Gemini local example:
# SEMANTIC_GUARD_PROVIDER=openai-compatible
# SEMANTIC_GUARD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# SEMANTIC_GUARD_MODEL_NAME=gemini-3.5-flash-lite
# SEMANTIC_GUARD_API_KEY=<GEMINI_API_KEY>
SEMANTIC_GUARD_PROVIDER=deterministic
SEMANTIC_GUARD_BASE_URL=http://localhost:8000/v1
SEMANTIC_GUARD_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-Guard
SEMANTIC_GUARD_API_KEY=
SEMANTIC_GUARD_TIMEOUT_MS=30000

# ITI Bedrock gateway transport. Morshid never connects to AWS directly. Keep
# the key blank while deterministic is selected; when aws-bedrock is selected
# the key must be printable ASCII only, because it is sent as an Authorization
# header value. The base URL must be HTTPS to a public host, with no userinfo,
# query, or fragment; that policy is only enforced when aws-bedrock is
# selected. HTTP is a temporary local-only exception: it must be explicitly
# enabled and is rejected in production. ITI_BEDROCK_ALLOW_INSECURE_HTTP
# accepts only true, false, or blank, and blank is read as false.
ITI_BEDROCK_GATEWAY_BASE_URL=https://apiaccess.iti.net.eg/api/v1
ITI_BEDROCK_GATEWAY_API_KEY=
ITI_BEDROCK_ALLOW_INSECURE_HTTP=false

# AWS Bedrock model policy. There is deliberately no committed model default.
# When aws-bedrock is selected, set one model and include its exact ID in the
# comma-separated local allow-list. Model changes take effect after restart.
# AWS_BEDROCK_MAX_TOKENS must be 256-4096 whatever the provider: a smaller
# budget has been observed answering HTTP 200 with blank output while still
# billing a gateway usage event.
AWS_BEDROCK_MODEL_ID=
AWS_BEDROCK_ALLOWED_MODEL_IDS=
AWS_BEDROCK_MAX_TOKENS=1024

# Optional Gemini development/demo configuration. Keep these entries commented
# in committed files. Copy them into the ignored server/.env only after the
# exposed key has been revoked and replaced with a new AI Studio authorization
# key. Never use real student activity, private materials, assessments, PII, or
# data from minors with the free tier.
#
# GEMINI_DEMO_ACKNOWLEDGED is an operator acknowledgement, not a feature switch.
# Setting it to true states that you accept that free-tier inputs AND outputs
# may be reviewed and used to improve Google's products (see
# docs/research/gemini-free-tier-quotas-2026-07-23.md), and that only synthetic,
# permission-safe data will be sent. It is required whenever COMPLETION_PROVIDER
# is gemini; it defaults to false and reads a blank value as false. It is also
# not sufficient on its own: gemini is rejected outright when NODE_ENV=production.
#
# Use a stable non-preview model ID. Copy the signed-in project's current
# RPM/TPM/RPD limits from AI Studio and set the effective caps no higher than
# 90% of those values. Hour and month are additional Morshid-owned budgets.
#
# The four request caps must satisfy minute <= hour <= day <= month or the
# server refuses to boot, so choose the hour and month budgets after the
# provider-derived RPM/RPD values rather than independently. Input TPM is a
# separate token dimension and is not part of that ordering.
#
# Windows differ per dimension, and the day/month units are not the AI Studio
# dashboard's. Minute and hour caps are continuously refilling token buckets.
# GEMINI_REQUESTS_PER_DAY is a fixed window that resets at 00:00 UTC, and
# GEMINI_REQUESTS_PER_MONTH is a fixed epoch-aligned 30-day window, so it does
# not reset on the 1st of the month. Google resets its own requests-per-day at
# midnight Pacific, so this day boundary leads Google's by 7-8 hours.
#
# The budget is keyed on GEMINI_API_KEY (stored only as a salted, truncated
# digest) because Gemini limits are per Google project: changing GEMINI_MODEL
# keeps the existing day and month spend.
#
# GEMINI_DEMO_ACKNOWLEDGED=true
# GEMINI_API_KEY=replace-with-new-ai-studio-authorization-key
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_REQUESTS_PER_MINUTE=replace-with-effective-rpm
# GEMINI_INPUT_TOKENS_PER_MINUTE=replace-with-effective-input-tpm
# GEMINI_REQUESTS_PER_HOUR=replace-with-internal-hour-budget
# GEMINI_REQUESTS_PER_DAY=replace-with-effective-rpd
# GEMINI_REQUESTS_PER_MONTH=replace-with-internal-month-budget

# Course-scoped retrieval configuration. Both values are validated at startup
# and are never accepted from request, provider, or prompt input. TOP_K caps
# how many ranked chunks a retrieval returns (1-50); MIN_SIMILARITY (0-1) is
# the cosine-similarity floor below which retrieval reports insufficient
# evidence. Cosine similarity ranges [-1, 1], so a floor of 0 still excludes
# negatively correlated chunks — there is no "no threshold" setting. The
# 0.62 floor is calibrated from the Python MVP corpus retrieval diagnostic.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.62

# Auth/session configuration.
# Access JWTs are signed with HS256 using this secret. Use a unique random
# value with at least 32 characters per environment. The two secrets below must
# differ and must not keep the `replace-with` placeholder — the server refuses
# to boot otherwise.
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-unique-32+-char-access-secret

# Refresh tokens are generated as opaque random values. The API stores only
# HMAC-SHA256(refreshToken, this secret), never the raw refresh token.
AUTH_REFRESH_TOKEN_HASH_SECRET=replace-with-a-different-32+-char-refresh-secret

# Access token lifetime in seconds. Default: 900 seconds / 15 minutes.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in days. Default: 7 days.
AUTH_REFRESH_TOKEN_TTL_DAYS=7
