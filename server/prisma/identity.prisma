// Domain-grouped Prisma schema. Cross-file relations are intentional.

enum UserRole {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  STUDENT

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum UniversityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("university_status")
}

enum UserImportStatus {
  PENDING
  APPROVED

  @@map("user_import_status")
}

enum UserImportRowStatus {
  VALID
  INVALID
  APPROVED
  CANCELLED

  @@map("user_import_row_status")
}

model University {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String           @db.VarChar(160)
  code      String           @unique(map: "universities_code_key") @db.VarChar(50)
  status    UniversityStatus @default(ACTIVE)
  ownerId   String?          @unique(map: "universities_owner_id_key") @map("owner_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner     User?            @relation("UniversityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  users     User[]           @relation("UniversityUsers")
  courses   Course[]         @relation("UniversityCourses")

  @@index([status], map: "idx_universities_status")
  @@map("universities")
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String     @unique(map: "users_email_key") @db.Citext
  displayName       String     @map("display_name") @db.VarChar(120)
  role              UserRole
  status            UserStatus @default(ACTIVE)
  universityId      String?    @map("university_id") @db.Uuid
  passwordHash      String     @map("password_hash") @db.Text
  disabledAt        DateTime?  @map("disabled_at") @db.Timestamptz(6)
  disabledById      String?    @map("disabled_by") @db.Uuid
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  university         University?         @relation("UniversityUsers", fields: [universityId], references: [id], onDelete: Restrict)
  ownedUniversity    University?         @relation("UniversityOwner")
  disabledBy         User?               @relation("UserDisabledBy", fields: [disabledById], references: [id], onDelete: SetNull)
  disabledUsers      User[]              @relation("UserDisabledBy")
  refreshTokens      RefreshToken[]      @relation("UserRefreshTokens")
  createdCourses     Course[]            @relation("CourseCreatedBy")
  memberships        CourseMembership[]  @relation("CourseMembershipUser")
  createdMemberships CourseMembership[]  @relation("CourseMembershipCreatedBy")
  uploadedMaterials  Material[]          @relation("MaterialUploadedBy")
  chatSessions       ChatSession[]       @relation("ChatSessionStudent")
  messages           Message[]           @relation("MessageAuthor")
  auditLogs          AuditLog[]          @relation("AuditActor")
  requestedReviews   ReviewCase[]        @relation("ReviewCaseRequester")
  assignedReviews    ReviewCase[]        @relation("ReviewCaseAssignee")
  resolvedReviews    ReviewCase[]        @relation("ReviewCaseResolver")
  reviewTriggers     ReviewTrigger[]     @relation("ReviewTriggerActor")
  reviewActions      ReviewAction[]      @relation("ReviewActionActor")
  idempotencyRecords IdempotencyRecord[]
  inboxItems         ReviewInboxItem[]   @relation("ReviewInboxRecipient")
  tutoringPreference StudentTutoringPreference?
  userImports        UserImport[]        @relation("UserImportCreatedBy")

  @@index([disabledById], map: "idx_users_disabled_by")
  @@index([universityId, role], map: "idx_users_university_role")
  @@map("users")
}

model UserImport {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status      UserImportStatus @default(PENDING)
  createdById String           @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt  DateTime?        @map("approved_at") @db.Timestamptz(6)

  createdBy User            @relation("UserImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  rows      UserImportRow[]

  @@index([createdById, createdAt], map: "idx_user_imports_creator_created")
  @@map("user_imports")
}

model UserImportRow {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId      String              @map("import_id") @db.Uuid
  rowNumber     Int                 @map("row_number")
  displayName   String?             @map("display_name") @db.VarChar(120)
  email         String?             @db.Citext
  role          UserRole?
  passwordHash  String?             @map("password_hash") @db.Text
  status        UserImportRowStatus
  errors        Json                @default("[]") @db.JsonB
  createdUserId String?             @map("created_user_id") @db.Uuid

  import UserImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber], map: "user_import_rows_import_row_key")
  @@index([importId, status], map: "idx_user_import_rows_import_status")
  @@map("user_import_rows")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid
  familyCreatedAt   DateTime  @default(now()) @map("family_created_at") @db.Timestamptz(6)
  tokenHash         String    @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.Text
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  ip                String?   @db.Inet
  userAgent         String?   @map("user_agent") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User           @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacedTokens  RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([userId, familyId], map: "idx_refresh_tokens_user_family")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([replacedByTokenId], map: "idx_refresh_tokens_replaced_by")
  @@map("refresh_tokens")
}
