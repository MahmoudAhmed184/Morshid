// Domain-grouped Prisma schema. Cross-file relations are intentional.

enum ExplanationDetailLevel {
  CONCISE
  STANDARD
  DETAILED

  @@map("explanation_detail_level")
}

enum TopicStatus {
  ACTIVE
  PAUSED
  RESOLVED
  ABANDONED

  @@map("topic_status")
}

enum SolutionProtectionStatus {
  UNKNOWN
  UNPROTECTED
  PROTECTED

  @@map("solution_protection_status")
}

enum SolutionProtectionSource {
  AUTHORITATIVE_TASK_METADATA
  EXPLICIT_PROTECTED_REQUEST
  ACCEPTED_TASK_ANALYSIS
  ACCEPTED_CONCEPT_ANALYSIS
  MIGRATED_TOPIC_HISTORY
  MIGRATED_CONCEPT_TOPIC
  CONSERVATIVE_UNKNOWN

  @@map("solution_protection_source")
}

enum OutputRiskAuditSource {
  APPROVAL_CANDIDATE
  SAFE_FALLBACK
  POST_APPROVAL

  @@map("output_risk_audit_source")
}

enum TutoringAttemptStatus {
  RECEIVED
  ANALYZING
  RETRIEVING
  DECIDING
  GENERATING
  VALIDATING
  REGENERATING
  COMPLETED
  FAILED

  @@map("tutoring_attempt_status")
}

enum TutoringAttemptFailureCode {
  ANALYSIS_FAILED
  RETRIEVAL_FAILED
  GENERATION_FAILED
  STRUCTURAL_VALIDATION_FAILED
  DETERMINISTIC_GUARD_REJECTED
  SEMANTIC_GUARD_REJECTED
  REGENERATION_EXHAUSTED
  PERSISTENCE_FAILED

  @@map("tutoring_attempt_failure_code")
}

enum TutoringCandidateGenerationOutcome {
  GENERATED
  INVALID_OUTPUT
  INFRASTRUCTURE_EXHAUSTED

  @@map("tutoring_candidate_generation_outcome")
}

enum GuardValidationStage {
  STRUCTURAL
  DETERMINISTIC
  SEMANTIC

  @@map("guard_validation_stage")
}

enum GuardRecommendedAction {
  APPROVE
  REGENERATE
  USE_SAFE_FALLBACK

  @@map("guard_recommended_action")
}

enum TutoringApprovalSource {
  VALIDATED_CANDIDATE
  SAFE_FALLBACK
  CLASSIFIED_RESPONSE

  @@map("tutoring_approval_source")
}

enum TutoringSafeFallbackReason {
  VALIDATION_EXHAUSTED
  GUARD_UNAVAILABLE
  GENERATION_RETRY_FAILED

  @@map("tutoring_safe_fallback_reason")
}

enum StudentState {
  UNKNOWN
  NO_PRIOR_KNOWLEDGE
  PARTIAL_UNDERSTANDING
  MISCONCEPTION
  DEBUGGING_ISSUE
  NEAR_SOLUTION

  @@map("student_state")
}

enum TeachingStrategy {
  GUIDED_EXPLANATION
  SOCRATIC_QUESTIONING
  MISCONCEPTION_REPAIR
  DEBUGGING_GUIDANCE

  @@map("teaching_strategy")
}

enum TeachingTechnique {
  ORIENTATION_QUESTION
  FOCUSED_QUESTION
  DECOMPOSITION
  ANALOGY
  COMPARISON
  COUNTEREXAMPLE
  TRACE_EXECUTION
  BOUNDARY_CHECK
  SELF_EXPLANATION
  VERIFICATION

  @@map("teaching_technique")
}

enum StudentActionPurpose {
  PRIOR_ATTEMPT_ORIENTATION
  CONCEPTUAL_UNDERSTANDING
  PRIMARY_TECHNIQUE

  @@map("student_action_purpose")
}

enum RevealPolicy {
  NO_FINAL_ANSWER
  PARTIAL_RESULT_ALLOWED
  FINAL_REASONING_ALLOWED
  COMPLETE_SOLUTION_ALLOWED

  @@map("reveal_policy")
}

enum ReflectionMode {
  NONE
  SELF_EXPLANATION
  VERIFICATION
  TRANSFER

  @@map("reflection_mode")
}

enum MisconceptionStatus {
  SUSPECTED
  ACTIVE
  CORRECTED
  DISMISSED

  @@map("misconception_status")
}

enum TopicType {
  PROBLEM
  CONCEPT
  DEBUGGING_TASK
  ASSIGNMENT_ITEM
  MISCONCEPTION_REPAIR
  UNCLASSIFIED

  @@map("topic_type")
}

enum LearningStatus {
  UNKNOWN
  IN_PROGRESS
  DEMONSTRATED
  VERIFIED

  @@map("learning_status")
}

enum ResolutionEvidenceStrength {
  NONE
  WEAK
  MODERATE
  STRONG

  @@map("resolution_evidence_strength")
}

enum EducationalAnalysisEvidenceKind {
  TOP_LEVEL
  EFFORT
  LEARNING

  @@map("educational_analysis_evidence_kind")
}

model Topic {
  id                              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId                       String                    @map("session_id") @db.Uuid
  courseId                        String                    @map("course_id") @db.Uuid
  problemId                       String?                   @map("problem_id") @db.Uuid
  conceptId                       String?                   @map("concept_id") @db.Uuid
  title                           String                    @db.VarChar(160)
  topicType                       TopicType                 @default(UNCLASSIFIED) @map("topic_type")
  status                          TopicStatus               @default(ACTIVE)
  solutionProtectionStatus        SolutionProtectionStatus  @default(UNKNOWN) @map("solution_protection_status")
  solutionProtectionSource        SolutionProtectionSource? @map("solution_protection_source")
  solutionProtectionPolicyVersion String?                   @map("solution_protection_policy_version") @db.VarChar(80)
  solutionProtectionEstablishedAt DateTime?                 @map("solution_protection_established_at") @db.Timestamptz(6)
  createdAt                       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt                      DateTime?                 @map("resolved_at") @db.Timestamptz(6)

  session             ChatSession           @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  course              Course                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  state               TopicState?
  attempts            TutoringAttempt[]
  messages            Message[]             @relation("MessageTopic")
  educationalAnalyses EducationalAnalysis[]
  teachingDecisions   TeachingDecision[]

  @@index([sessionId, status], map: "idx_topics_session_status")
  @@index([courseId, problemId], map: "idx_topics_course_problem")
  @@index([courseId, conceptId], map: "idx_topics_course_concept")
  @@map("topics")
}

model TopicState {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId                    String                     @unique(map: "topic_states_topic_id_key") @map("topic_id") @db.Uuid
  version                    Int                        @default(1)
  requestKind                MessageRequestKind?        @map("request_kind")
  studentState               StudentState               @default(UNKNOWN) @map("student_state")
  activeStrategy             TeachingStrategy?          @map("active_strategy")
  primaryTechnique           TeachingTechnique?         @map("primary_technique")
  supportingTechnique        TeachingTechnique?         @map("supporting_technique")
  guidanceLevel              Int                        @default(1) @map("guidance_level") @db.SmallInt
  revealPolicy               RevealPolicy               @default(NO_FINAL_ANSWER) @map("reveal_policy")
  attemptCount               Int                        @default(0) @map("attempt_count")
  meaningfulAttemptCount     Int                        @default(0) @map("meaningful_attempt_count")
  misconceptionStatus        MisconceptionStatus?       @map("misconception_status")
  learningStatus             LearningStatus             @default(UNKNOWN) @map("learning_status")
  resolutionEvidenceStrength ResolutionEvidenceStrength @default(NONE) @map("resolution_evidence_strength")
  summary                    String?                    @db.Text
  lastTutorQuestion          String?                    @map("last_tutor_question") @db.Text
  lastStudentAction          String?                    @map("last_student_action") @db.Text
  resolved                   Boolean                    @default(false)
  updatedAt                  DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@map("topic_states")
}

model TutoringAttempt {
  id                              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId                       String                      @map("session_id") @db.Uuid
  topicId                         String?                     @map("topic_id") @db.Uuid
  studentMessageId                String?                     @map("student_message_id") @db.Uuid
  assistantMessageId              String?                     @map("assistant_message_id") @db.Uuid
  retryOfAttemptId                String?                     @map("retry_of_attempt_id") @db.Uuid
  clientMessageId                 String                      @map("client_message_id") @db.VarChar(160)
  requestKind                     MessageRequestKind?         @map("request_kind")
  status                          TutoringAttemptStatus       @default(RECEIVED)
  explanationDetailLevel          ExplanationDetailLevel      @default(STANDARD) @map("explanation_detail_level")
  failureCode                     TutoringAttemptFailureCode? @map("failure_code")
  leaseExpiresAt                  DateTime?                   @map("lease_expires_at") @db.Timestamptz(6)
  safeFallbackUsed                Boolean                     @default(false) @map("safe_fallback_used")
  approvalSource                  TutoringApprovalSource?     @map("approval_source")
  approvedCandidateAttempt        Int?                        @map("approved_candidate_attempt") @db.SmallInt
  safeFallbackReason              TutoringSafeFallbackReason? @map("safe_fallback_reason")
  validationPolicyVersion         String?                     @map("validation_policy_version") @db.VarChar(80)
  explicitProtectedSolutionSignal Boolean                     @default(false) @map("explicit_protected_solution_signal")
  effectiveSolutionProtection     Boolean?                    @map("effective_solution_protection")
  solutionProtectionSource        SolutionProtectionSource?   @map("solution_protection_source")
  solutionProtectionPolicyVersion String?                     @map("solution_protection_policy_version") @db.VarChar(80)
  solutionProtectionResolvedAt    DateTime?                   @map("solution_protection_resolved_at") @db.Timestamptz(6)
  createdAt                       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt                     DateTime?                   @map("completed_at") @db.Timestamptz(6)

  session             ChatSession                @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  topic               Topic?                     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  studentMessage      Message?                   @relation("TutoringAttemptStudentMessage", fields: [studentMessageId], references: [id], onDelete: SetNull)
  assistantMessage    Message?                   @relation("TutoringAttemptAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  retryOf             TutoringAttempt?           @relation("TutoringAttemptRetry", fields: [retryOfAttemptId], references: [id], onDelete: SetNull)
  retries             TutoringAttempt[]          @relation("TutoringAttemptRetry")
  messages            Message[]                  @relation("MessageAttempt")
  educationalAnalyses EducationalAnalysis[]
  teachingDecision    TeachingDecision?
  debuggingDiagnosis  DebuggingDiagnosis?
  candidateAttempts   TutoringCandidateAttempt[]
  outputRiskEvents    OutputRiskEvent[]

  @@unique([sessionId, clientMessageId], map: "tutoring_attempts_session_id_client_message_id_key")
  @@index([topicId], map: "idx_tutoring_attempts_topic")
  @@index([studentMessageId], map: "idx_tutoring_attempts_student_message")
  @@index([sessionId, status, leaseExpiresAt], map: "idx_tutoring_attempts_session_status_lease")
  @@map("tutoring_attempts")
}

model OutputRiskEvent {
  id                              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId                       String                   @map("attempt_id") @db.Uuid
  candidateAttempt                Int?                     @map("candidate_attempt") @db.SmallInt
  source                          OutputRiskAuditSource
  detectorVersion                 String                   @map("detector_version") @db.VarChar(80)
  risks                           Json
  protectTargetSolution           Boolean                  @map("protect_target_solution")
  solutionProtectionSource        SolutionProtectionSource @map("solution_protection_source")
  solutionProtectionPolicyVersion String                   @map("solution_protection_policy_version") @db.VarChar(80)
  createdAt                       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  turn TutoringAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([attemptId], map: "idx_output_risk_events_attempt")
  @@map("output_risk_events")
}

model TutoringCandidateAttempt {
  id                       String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId                   String                          @map("attempt_id") @db.Uuid
  candidateAttempt         Int                             @map("candidate_attempt") @db.SmallInt
  generationOutcome        TutoringCandidateGenerationOutcome @map("generation_outcome")
  generationFailureCode    String?                         @map("generation_failure_code") @db.VarChar(80)
  contentHash              String?                         @map("content_hash") @db.VarChar(64)
  provider                 String?                         @db.VarChar(80)
  model                    String?                         @db.VarChar(200)
  promptVersion            String?                         @map("prompt_version") @db.VarChar(80)
  inputTokens              Int?                            @map("input_tokens")
  outputTokens             Int?                            @map("output_tokens")
  infrastructureRetryCount Int                             @default(0) @map("infrastructure_retry_count")
  startedAt                DateTime                        @map("started_at") @db.Timestamptz(6)
  completedAt              DateTime                        @map("completed_at") @db.Timestamptz(6)
  createdAt                DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  turn         TutoringAttempt     @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  guardResults GuardResult[]

  @@unique([attemptId, candidateAttempt], map: "tutoring_candidate_attempts_attempt_key")
  @@map("tutoring_candidate_attempts")
}

model GuardResult {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId                  String                 @map("attempt_id") @db.Uuid
  candidateAttempt        Int                    @map("candidate_attempt") @db.SmallInt
  validationStage         GuardValidationStage   @map("validation_stage")
  approved                Boolean
  violations              Json
  maximumSeverity         String?                @map("maximum_severity") @db.VarChar(16)
  recommendedAction       GuardRecommendedAction @map("recommended_action")
  provider                String?                @db.VarChar(80)
  model                   String?                @db.VarChar(200)
  promptVersion           String?                @map("prompt_version") @db.VarChar(80)
  validationPolicyVersion String                 @map("validation_policy_version") @db.VarChar(80)
  teachingPolicyVersion   String                 @map("teaching_policy_version") @db.VarChar(80)
  disclosurePolicyVersion String                 @map("disclosure_policy_version") @db.VarChar(80)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  candidate TutoringCandidateAttempt @relation(fields: [attemptId, candidateAttempt], references: [attemptId, candidateAttempt], onDelete: Restrict)

  @@unique([attemptId, candidateAttempt, validationStage], map: "guard_results_attempt_stage_key")
  @@map("guard_results")
}

model EducationalAnalysis {
  id                                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId                             String             @map("attempt_id") @db.Uuid
  topicId                            String             @map("topic_id") @db.Uuid
  studentMessageId                   String             @map("student_message_id") @db.Uuid
  attempt                            Int                @default(1)
  requestKind                        MessageRequestKind @map("request_kind")
  studentState                       StudentState       @map("student_state")
  effortPresent                      Boolean            @map("effort_present")
  effortQuality                      String             @map("effort_quality") @db.VarChar(20)
  effortType                         String?            @map("effort_type") @db.VarChar(40)
  effortAddressesPreviousTutorAction Boolean            @map("effort_addresses_previous_tutor_action")
  effortIsRepeated                   Boolean            @map("effort_is_repeated")
  learningEvidencePresent            Boolean            @map("learning_evidence_present")
  learningEvidenceStrength           String             @map("learning_evidence_strength") @db.VarChar(20)
  topicRelation                      String             @map("topic_relation") @db.VarChar(40)
  recommendedStrategy                TeachingStrategy   @map("recommended_strategy")
  recommendedTechnique               TeachingTechnique  @map("recommended_technique")
  recommendedGuidanceLevel           Int                @map("recommended_guidance_level") @db.SmallInt
  confidence                         Float
  provider                           String             @db.VarChar(80)
  model                              String             @db.VarChar(200)
  modelVersion                       String?            @map("model_version") @db.VarChar(200)
  promptVersion                      String             @map("prompt_version") @db.VarChar(80)
  schemaVersion                      String             @map("schema_version") @db.VarChar(80)
  inputTokens                        Int?               @map("input_tokens")
  outputTokens                       Int?               @map("output_tokens")
  latencyMs                          Int?               @map("latency_ms")
  analysisSource                     String             @default("model") @map("analysis_source") @db.VarChar(40)
  fallbackReason                     String?            @map("fallback_reason") @db.VarChar(80)
  failureCategory                    String?            @map("failure_category") @db.VarChar(120)
  confidencePolicyVersion            String?            @map("confidence_policy_version") @db.VarChar(120)
  infrastructureRetryCount           Int                @default(0) @map("infrastructure_retry_count")
  createdAt                          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  turn              TutoringAttempt                          @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  topic            Topic                              @relation(fields: [topicId], references: [id], onDelete: Restrict)
  studentMessage   Message                            @relation("EducationalAnalysisStudentMessage", fields: [studentMessageId], references: [id], onDelete: Restrict)
  evidenceLinks    EducationalAnalysisEvidenceLink[]
  misconceptions   EducationalAnalysisMisconception[]
  teachingDecision TeachingDecision?

  @@unique([attemptId, attempt], map: "educational_analyses_attempt_id_attempt_key")
  @@index([topicId, createdAt], map: "idx_educational_analyses_topic_created")
  @@index([studentMessageId], map: "idx_educational_analyses_student_message")
  @@map("educational_analyses")
}

model TeachingDecision {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId               String             @unique(map: "teaching_decisions_attempt_id_key") @map("attempt_id") @db.Uuid
  topicId              String             @map("topic_id") @db.Uuid
  analysisId           String             @unique(map: "teaching_decisions_analysis_id_key") @map("analysis_id") @db.Uuid
  strategy             TeachingStrategy
  primaryTechnique     TeachingTechnique  @map("primary_technique")
  supportingTechnique  TeachingTechnique? @map("supporting_technique")
  guidanceLevel        Int                @map("guidance_level") @db.SmallInt
  revealPolicy         RevealPolicy       @map("reveal_policy")
  reflectionMode       ReflectionMode     @map("reflection_mode")
  requireStudentAction Boolean            @map("require_student_action")
  studentActionPurpose StudentActionPurpose @map("student_action_purpose")
  guardPolicy          Json               @map("guard_policy")
  decisionReason       String             @map("decision_reason") @db.VarChar(240)
  policyVersion        String             @map("policy_version") @db.VarChar(80)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  turn     TutoringAttempt           @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  topic    Topic               @relation(fields: [topicId], references: [id], onDelete: Restrict)
  analysis EducationalAnalysis @relation(fields: [analysisId], references: [id], onDelete: Restrict)

  @@index([topicId, createdAt], map: "idx_teaching_decisions_topic_created")
  @@index([policyVersion], map: "idx_teaching_decisions_policy_version")
  @@map("teaching_decisions")
}

model DebuggingDiagnosis {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutoringAttemptId      String   @unique(map: "debugging_diagnoses_attempt_id_key") @map("tutoring_attempt_id") @db.Uuid
  schemaVersion          String   @map("schema_version") @db.VarChar(80)
  status                 String   @db.VarChar(20)
  source                 String   @db.VarChar(20)
  language               String?  @db.VarChar(80)
  category               String   @db.VarChar(40)
  confidence             String   @db.VarChar(20)
  likelyDefect           String?  @map("likely_defect") @db.Text
  locationMessageId      String   @map("location_message_id") @db.Uuid
  lineStart              Int?     @map("line_start")
  lineEnd                Int?     @map("line_end")
  locationKind           String   @map("location_kind") @db.VarChar(20)
  evidence               Json
  underlyingConcept      String?  @map("underlying_concept") @db.Text
  requiresRuntimeEvidence Boolean @map("requires_runtime_evidence")
  runtimeEvidenceNeeded  String   @map("runtime_evidence_needed") @db.VarChar(40)
  inspectionGoal         String   @map("inspection_goal") @db.Text
  fallbackReason         String?  @map("fallback_reason") @db.VarChar(80)
  provider               String?  @db.VarChar(80)
  model                  String?  @db.VarChar(200)
  promptVersion          String?  @map("prompt_version") @db.VarChar(80)
  inputTokens            Int?     @map("input_tokens")
  outputTokens           Int?     @map("output_tokens")
  infrastructureRetryCount Int    @default(0) @map("infrastructure_retry_count")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  turn TutoringAttempt @relation(fields: [tutoringAttemptId], references: [id], onDelete: Restrict)

  @@index([locationMessageId], map: "idx_debugging_diagnoses_location_message")
  @@map("debugging_diagnoses")
}

model EducationalAnalysisEvidenceLink {
  id         String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId String                          @map("analysis_id") @db.Uuid
  messageId  String                          @map("message_id") @db.Uuid
  kind       EducationalAnalysisEvidenceKind
  ordinal    Int
  createdAt  DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  analysis EducationalAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  message  Message             @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@unique([analysisId, kind, ordinal], map: "educational_analysis_evidence_links_analysis_kind_ordinal_key")
  @@index([messageId], map: "idx_educational_analysis_evidence_links_message")
  @@map("educational_analysis_evidence_links")
}

model EducationalAnalysisMisconception {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId        String   @map("analysis_id") @db.Uuid
  code              String   @db.VarChar(64)
  description       String   @db.Text
  confidence        Float
  evidenceMessageId String   @map("evidence_message_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  analysis        EducationalAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  evidenceMessage Message             @relation("EducationalAnalysisMisconceptionEvidence", fields: [evidenceMessageId], references: [id], onDelete: Restrict)

  @@index([analysisId], map: "idx_educational_analysis_misconceptions_analysis")
  @@index([evidenceMessageId], map: "idx_educational_analysis_misconceptions_evidence")
  @@map("educational_analysis_misconceptions")
}

model StudentTutoringPreference {
  studentId              String                 @id @map("student_id") @db.Uuid
  explanationDetailLevel ExplanationDetailLevel @default(STANDARD) @map("explanation_detail_level")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@map("student_tutoring_preferences")
}

