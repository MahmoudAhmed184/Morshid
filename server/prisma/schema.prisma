generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum CourseMembershipRole {
  INSTRUCTOR
  STUDENT

  @@map("course_membership_role")
}

enum MaterialStatus {
  PROCESSING
  READY
  WARNING
  FAILED

  @@map("material_status")
}

enum MessageRole {
  STUDENT
  ASSISTANT
  SYSTEM

  @@map("message_role")
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  BLOCKED

  @@map("message_status")
}

enum MessageRequestKind {
  CONCEPTUAL
  PROBLEM_LIKE
  ATTEMPT_DIAGNOSIS
  CODE_DIAGNOSIS
  UNSAFE
  OFF_TOPIC
  AMBIGUOUS

  @@map("message_request_kind")
}

enum MessageGuidanceLabel {
  COURSE_GROUNDED
  GENERAL_NOT_FOUND
  UNCERTAIN_AWAITING_REVIEW
  INSTRUCTOR_REVIEWED
  REFUSAL

  @@map("message_guidance_label")
}

enum TopicStatus {
  ACTIVE
  PAUSED
  RESOLVED
  ABANDONED

  @@map("topic_status")
}

enum TutorTurnStatus {
  RECEIVED
  ANALYZING
  RETRIEVING
  DECIDING
  GENERATING
  VALIDATING
  REGENERATING
  COMPLETED
  FAILED

  @@map("tutor_turn_status")
}

enum TutorTurnFailureCode {
  ANALYSIS_FAILED
  RETRIEVAL_FAILED
  GENERATION_FAILED
  STRUCTURAL_VALIDATION_FAILED
  DETERMINISTIC_GUARD_REJECTED
  SEMANTIC_GUARD_REJECTED
  REGENERATION_EXHAUSTED
  PERSISTENCE_FAILED

  @@map("tutor_turn_failure_code")
}

enum TutorCandidateGenerationOutcome {
  GENERATED
  INVALID_OUTPUT
  INFRASTRUCTURE_EXHAUSTED

  @@map("tutor_candidate_generation_outcome")
}

enum GuardValidationStage {
  STRUCTURAL
  DETERMINISTIC
  SEMANTIC

  @@map("guard_validation_stage")
}

enum GuardRecommendedAction {
  APPROVE
  REGENERATE
  USE_SAFE_FALLBACK

  @@map("guard_recommended_action")
}

enum TutorApprovalSource {
  VALIDATED_CANDIDATE
  SAFE_FALLBACK

  @@map("tutor_approval_source")
}

enum TutorSafeFallbackReason {
  VALIDATION_EXHAUSTED
  GUARD_UNAVAILABLE
  GENERATION_RETRY_FAILED
  GROUNDING_UNAVAILABLE
  LEGACY_UNCLASSIFIED

  @@map("tutor_safe_fallback_reason")
}

enum StudentState {
  UNKNOWN
  NO_PRIOR_KNOWLEDGE
  PARTIAL_UNDERSTANDING
  MISCONCEPTION
  DEBUGGING_ISSUE
  NEAR_SOLUTION

  @@map("student_state")
}

enum TeachingStrategy {
  GUIDED_EXPLANATION
  SOCRATIC_QUESTIONING
  MISCONCEPTION_REPAIR
  DEBUGGING_GUIDANCE

  @@map("teaching_strategy")
}

enum TeachingTechnique {
  ORIENTATION_QUESTION
  FOCUSED_QUESTION
  DECOMPOSITION
  ANALOGY
  COMPARISON
  COUNTEREXAMPLE
  TRACE_EXECUTION
  BOUNDARY_CHECK
  SELF_EXPLANATION
  VERIFICATION

  @@map("teaching_technique")
}

enum RevealPolicy {
  NO_FINAL_ANSWER
  PARTIAL_RESULT_ALLOWED
  FINAL_REASONING_ALLOWED
  COMPLETE_SOLUTION_ALLOWED

  @@map("reveal_policy")
}

enum ReflectionMode {
  NONE
  SELF_EXPLANATION
  VERIFICATION
  TRANSFER

  @@map("reflection_mode")
}

enum MisconceptionStatus {
  SUSPECTED
  ACTIVE
  CORRECTED
  DISMISSED

  @@map("misconception_status")
}

enum TopicType {
  PROBLEM
  CONCEPT
  DEBUGGING_TASK
  ASSIGNMENT_ITEM
  MISCONCEPTION_REPAIR
  UNCLASSIFIED

  @@map("topic_type")
}

enum LearningStatus {
  UNKNOWN
  IN_PROGRESS
  DEMONSTRATED
  VERIFIED

  @@map("learning_status")
}

enum ResolutionEvidenceStrength {
  NONE
  WEAK
  MODERATE
  STRONG

  @@map("resolution_evidence_strength")
}

enum EducationalAnalysisEvidenceKind {
  TOP_LEVEL
  EFFORT
  LEARNING

  @@map("educational_analysis_evidence_kind")
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED

  @@map("review_status")
}

enum ReviewTriggerType {
  STUDENT_REQUEST
  GENERAL_NOT_FOUND
  CITATION_MISSING
  SOURCE_CONFLICT
  POLICY_CHECK_FAILED
  FINAL_ANSWER_RISK

  @@map("review_trigger_type")
}

enum StudentFlagReason {
  INCORRECT
  CONFUSING
  UNHELPFUL
  COURSE_MISMATCH
  TOO_MUCH_ANSWER
  OTHER

  @@map("student_flag_reason")
}

enum ReviewActionType {
  CREATED
  TRIGGER_ADDED
  CLAIMED
  DRAFT_SAVED
  APPROVED
  EDITED
  REPLACED
  REJECTED

  @@map("review_action_type")
}

enum ReviewOutcome {
  APPROVED
  EDITED
  REPLACED
  REQUEST_REJECTED

  @@map("review_outcome")
}

enum NotificationType {
  REVIEW_RESOLVED
  REVIEW_REJECTED
  USAGE_LIMIT_REACHED

  @@map("notification_type")
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED

  @@map("notification_status")
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String     @unique(map: "users_email_key") @db.Citext
  displayName       String     @map("display_name") @db.VarChar(120)
  role              UserRole
  status            UserStatus @default(ACTIVE)
  passwordHash      String     @map("password_hash") @db.Text
  disabledAt        DateTime?  @map("disabled_at") @db.Timestamptz(6)
  disabledById      String?    @map("disabled_by") @db.Uuid
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  disabledBy         User?               @relation("UserDisabledBy", fields: [disabledById], references: [id], onDelete: SetNull)
  disabledUsers      User[]              @relation("UserDisabledBy")
  refreshTokens      RefreshToken[]      @relation("UserRefreshTokens")
  createdCourses     Course[]            @relation("CourseCreatedBy")
  memberships        CourseMembership[]  @relation("CourseMembershipUser")
  createdMemberships CourseMembership[]  @relation("CourseMembershipCreatedBy")
  uploadedMaterials  Material[]          @relation("MaterialUploadedBy")
  chatSessions       ChatSession[]       @relation("ChatSessionStudent")
  messages           Message[]           @relation("MessageAuthor")
  auditLogs          AuditLog[]          @relation("AuditActor")
  requestedReviews   ReviewCase[]        @relation("ReviewCaseRequester")
  assignedReviews    ReviewCase[]        @relation("ReviewCaseAssignee")
  resolvedReviews    ReviewCase[]        @relation("ReviewCaseResolver")
  reviewTriggers     ReviewTrigger[]     @relation("ReviewTriggerActor")
  reviewActions      ReviewAction[]      @relation("ReviewActionActor")
  idempotencyRecords IdempotencyRecord[]
  notifications      Notification[]      @relation("NotificationRecipient")

  @@index([disabledById], map: "idx_users_disabled_by")
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.Text
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  ip                String?   @db.Inet
  userAgent         String?   @map("user_agent") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User           @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacedTokens  RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([replacedByTokenId], map: "idx_refresh_tokens_replaced_by")
  @@map("refresh_tokens")
}

model Course {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique(map: "courses_code_key") @db.VarChar(40)
  title       String   @db.VarChar(160)
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy    User?              @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  memberships  CourseMembership[]
  materials    Material[]
  chatSessions ChatSession[]
  topics       Topic[]
  auditLogs    AuditLog[]
  reviewCases  ReviewCase[]

  @@index([createdById], map: "idx_courses_created_by")
  @@map("courses")
}

model CourseMembership {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String               @map("course_id") @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  role        CourseMembershipRole
  createdById String?              @map("created_by") @db.Uuid
  removedAt   DateTime?            @map("removed_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user         User          @relation("CourseMembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("CourseMembershipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  chatSessions ChatSession[] @relation("ChatSessionMembership")

  @@unique([courseId, userId], map: "course_memberships_course_id_user_id_key")
  @@index([courseId, role, removedAt], map: "idx_memberships_course_role_active")
  @@index([userId], map: "idx_memberships_user")
  @@index([createdById], map: "idx_memberships_created_by")
  @@map("course_memberships")
}

model Material {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId            String         @map("course_id") @db.Uuid
  uploadedById        String         @map("uploaded_by") @db.Uuid
  title               String         @db.VarChar(180)
  originalFilename    String         @map("original_filename") @db.Text
  storagePath         String         @map("storage_path") @db.Text
  sha256Hash          String?        @map("sha256_hash") @db.Char(64)
  status              MaterialStatus @default(PROCESSING)
  processingAttemptId String?        @map("processing_attempt_id") @db.Uuid
  extractedTextLength Int?           @map("extracted_text_length")
  chunkCount          Int?           @map("chunk_count")
  errorMessage        String?        @map("error_message") @db.Text
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course            Course                     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  uploadedBy        User                       @relation("MaterialUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  chunks            MaterialChunk[]
  citations         MessageCitation[]
  processingCommand MaterialProcessingCommand?

  @@index([courseId, status, deletedAt], map: "idx_materials_course_status")
  @@index([uploadedById], map: "idx_materials_uploaded_by")
  @@map("materials")
}

model ReviewCase {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetMessageId      String         @unique(map: "review_cases_target_message_id_key") @map("target_message_id") @db.Uuid
  courseId             String         @map("course_id") @db.Uuid
  requestedByUserId    String?        @map("requested_by_user_id") @db.Uuid
  assignedInstructorId String?        @map("assigned_instructor_id") @db.Uuid
  resolvedByUserId     String?        @map("resolved_by_user_id") @db.Uuid
  status               ReviewStatus   @default(PENDING)
  outcome              ReviewOutcome?
  draftContent         String?        @map("draft_content") @db.Text
  publishedContent     String?        @map("published_content") @db.Text
  resolutionReason     String?        @map("resolution_reason") @db.VarChar(500)
  version              Int            @default(1)
  assignedAt           DateTime?      @map("assigned_at") @db.Timestamptz(6)
  resolvedAt           DateTime?      @map("resolved_at") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  targetMessage      Message                 @relation(fields: [targetMessageId], references: [id], onDelete: Restrict)
  course             Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  requestedByUser    User?                   @relation("ReviewCaseRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  assignedInstructor User?                   @relation("ReviewCaseAssignee", fields: [assignedInstructorId], references: [id], onDelete: SetNull)
  resolvedByUser     User?                   @relation("ReviewCaseResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  triggers           ReviewTrigger[]
  evidence           ReviewEvidenceSnapshot?
  actions            ReviewAction[]
  notifications      Notification[]

  @@index([courseId, status, createdAt(sort: Desc), id(sort: Desc)], map: "idx_review_cases_course_status_created")
  @@index([assignedInstructorId, status, updatedAt(sort: Desc)], map: "idx_review_cases_assignee_status_updated")
  @@index([requestedByUserId, createdAt(sort: Desc)], map: "idx_review_cases_requester_created")
  @@map("review_cases")
}

model ReviewTrigger {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewCaseId      String             @map("review_case_id") @db.Uuid
  type              ReviewTriggerType
  actorUserId       String?            @map("actor_user_id") @db.Uuid
  studentFlagReason StudentFlagReason? @map("student_flag_reason")
  reason            String?            @db.VarChar(200)
  sourceEventKey    String?            @map("source_event_key") @db.VarChar(200)
  detectorMetadata  Json               @default("{}") @map("detector_metadata") @db.JsonB
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  reviewCase ReviewCase @relation(fields: [reviewCaseId], references: [id], onDelete: Cascade)
  actor      User?      @relation("ReviewTriggerActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([reviewCaseId, createdAt], map: "idx_review_triggers_case_created")
  @@index([type, createdAt], map: "idx_review_triggers_type_created")
  @@map("review_triggers")
}

model ReviewEvidenceSnapshot {
  reviewCaseId  String   @id @map("review_case_id") @db.Uuid
  schemaVersion Int      @default(1) @map("schema_version")
  evidence      Json     @db.JsonB
  contentHash   String   @map("content_hash") @db.Char(64)
  capturedAt    DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  reviewCase ReviewCase @relation(fields: [reviewCaseId], references: [id], onDelete: Cascade)

  @@map("review_evidence_snapshots")
}

model ReviewAction {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewCaseId String           @map("review_case_id") @db.Uuid
  actorUserId  String?          @map("actor_user_id") @db.Uuid
  actionType   ReviewActionType @map("action_type")
  fromStatus   ReviewStatus?    @map("from_status")
  toStatus     ReviewStatus     @map("to_status")
  content      String?          @db.Text
  reason       String?          @db.VarChar(1000)
  caseVersion  Int              @map("case_version")
  operationId  String           @unique(map: "review_actions_operation_id_key") @map("operation_id") @db.Uuid
  metadata     Json             @default("{}") @db.JsonB
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  reviewCase ReviewCase @relation(fields: [reviewCaseId], references: [id], onDelete: Cascade)
  actor      User?      @relation("ReviewActionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([reviewCaseId, caseVersion], map: "review_actions_case_version_key")
  @@index([reviewCaseId, createdAt, id], map: "idx_review_actions_case_created")
  @@map("review_actions")
}

model IdempotencyRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId        String   @map("actor_user_id") @db.Uuid
  operationScope     String   @map("operation_scope") @db.VarChar(80)
  key                String   @db.VarChar(200)
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  resourceId         String   @map("resource_id") @db.Uuid
  responseStatus     Int      @map("response_status") @db.SmallInt
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, operationScope, key], map: "idempotency_records_actor_scope_key_key")
  @@index([expiresAt], map: "idx_idempotency_records_expires")
  @@map("idempotency_records")
}

model Notification {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId String             @map("recipient_user_id") @db.Uuid
  reviewCaseId    String?            @map("review_case_id") @db.Uuid
  type            NotificationType
  status          NotificationStatus @default(UNREAD)
  metadata        Json               @default("{}") @db.JsonB
  readAt          DateTime?          @map("read_at") @db.Timestamptz(6)
  dismissedAt     DateTime?          @map("dismissed_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipient  User        @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  reviewCase ReviewCase? @relation(fields: [reviewCaseId], references: [id], onDelete: Restrict)

  @@map("notifications")
}

model MaterialProcessingCommand {
  materialId          String    @id @map("material_id") @db.Uuid
  processingAttemptId String?   @map("processing_attempt_id") @db.Uuid
  leaseExpiresAt      DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([leaseExpiresAt, createdAt], map: "idx_material_processing_commands_lease")
  @@map("material_processing_commands")
}

model MaterialChunk {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId     String                      @map("material_id") @db.Uuid
  chunkIndex     Int                         @map("chunk_index")
  content        String                      @db.Text
  /// Indexed by idx_chunks_embedding_hnsw, created in the
  /// 20260716224018_add_rag_persistence migration as
  /// `USING hnsw ("embedding" vector_cosine_ops)`. Prisma cannot express the
  /// HNSW access method or its operator class, so this field intentionally has
  /// no `@@index` declaration; adding one emits a plain B-tree CREATE INDEX and
  /// drops/rebuilds the vector index. See server/prisma/README.md.
  embedding      Unsupported("vector(1536)")
  embeddingModel String                      @map("embedding_model") @db.VarChar(120)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  material   Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  retrievals MessageRetrieval[]

  @@unique([materialId, chunkIndex], map: "material_chunks_material_id_chunk_index_key")
  @@map("material_chunks")
}

model ChatSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId      String    @map("course_id") @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  title         String    @db.VarChar(160)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSequence  Int       @default(0) @map("last_sequence")

  course     Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  student    User             @relation("ChatSessionStudent", fields: [studentId], references: [id], onDelete: Restrict)
  membership CourseMembership @relation("ChatSessionMembership", fields: [courseId, studentId], references: [courseId, userId], onDelete: Restrict)
  messages   Message[]
  topics     Topic[]
  tutorTurns TutorTurn[]

  @@index([courseId], map: "idx_sessions_course")
  @@index([courseId, studentId], map: "idx_sessions_course_student")
  @@index([studentId, courseId, deletedAt, lastMessageAt], map: "idx_sessions_student_course")
  @@map("chat_sessions")
}

model Topic {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String      @map("session_id") @db.Uuid
  courseId   String      @map("course_id") @db.Uuid
  problemId  String?     @map("problem_id") @db.Uuid
  conceptId  String?     @map("concept_id") @db.Uuid
  title      String      @db.VarChar(160)
  topicType  TopicType   @default(UNCLASSIFIED) @map("topic_type")
  status     TopicStatus @default(ACTIVE)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt DateTime?   @map("resolved_at") @db.Timestamptz(6)

  session             ChatSession           @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  course              Course                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  state               TopicState?
  turns               TutorTurn[]
  messages            Message[]             @relation("MessageTopic")
  educationalAnalyses EducationalAnalysis[]
  teachingDecisions   TeachingDecision[]

  @@index([sessionId, status], map: "idx_topics_session_status")
  @@index([courseId, problemId], map: "idx_topics_course_problem")
  @@index([courseId, conceptId], map: "idx_topics_course_concept")
  @@map("topics")
}

model TopicState {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId                    String                     @unique(map: "topic_states_topic_id_key") @map("topic_id") @db.Uuid
  version                    Int                        @default(1)
  requestKind                MessageRequestKind?        @map("request_kind")
  studentState               StudentState               @default(UNKNOWN) @map("student_state")
  activeStrategy             TeachingStrategy?          @map("active_strategy")
  primaryTechnique           TeachingTechnique?         @map("primary_technique")
  supportingTechnique        TeachingTechnique?         @map("supporting_technique")
  guidanceLevel              Int                        @default(1) @map("guidance_level") @db.SmallInt
  revealPolicy               RevealPolicy               @default(NO_FINAL_ANSWER) @map("reveal_policy")
  attemptCount               Int                        @default(0) @map("attempt_count")
  meaningfulAttemptCount     Int                        @default(0) @map("meaningful_attempt_count")
  misconceptionStatus        MisconceptionStatus?       @map("misconception_status")
  learningStatus             LearningStatus             @default(UNKNOWN) @map("learning_status")
  resolutionEvidenceStrength ResolutionEvidenceStrength @default(NONE) @map("resolution_evidence_strength")
  summary                    String?                    @db.Text
  lastTutorQuestion          String?                    @map("last_tutor_question") @db.Text
  lastStudentAction          String?                    @map("last_student_action") @db.Text
  resolved                   Boolean                    @default(false)
  updatedAt                  DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@map("topic_states")
}

model TutorTurn {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId                String                   @map("session_id") @db.Uuid
  topicId                  String?                  @map("topic_id") @db.Uuid
  studentMessageId         String?                  @map("student_message_id") @db.Uuid
  approvedTutorMessageId   String?                  @unique(map: "tutor_turns_approved_tutor_message_id_key") @map("approved_tutor_message_id") @db.Uuid
  idempotencyKey           String                   @map("idempotency_key") @db.VarChar(160)
  status                   TutorTurnStatus          @default(RECEIVED)
  failureCode              TutorTurnFailureCode?    @map("failure_code")
  safeFallbackUsed         Boolean                  @default(false) @map("safe_fallback_used")
  approvalSource           TutorApprovalSource?     @map("approval_source")
  approvedCandidateAttempt Int?                     @map("approved_candidate_attempt") @db.SmallInt
  safeFallbackReason       TutorSafeFallbackReason? @map("safe_fallback_reason")
  validationPolicyVersion  String?                  @map("validation_policy_version") @db.VarChar(80)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt              DateTime?                @map("completed_at") @db.Timestamptz(6)

  session              ChatSession             @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  topic                Topic?                  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  studentMessage       Message?                @relation("TutorTurnStudentMessage", fields: [studentMessageId], references: [id], onDelete: SetNull)
  approvedTutorMessage Message?                @relation("TutorTurnApprovedTutorMessage", fields: [approvedTutorMessageId], references: [id], onDelete: SetNull)
  messages             Message[]               @relation("MessageTurn")
  educationalAnalyses  EducationalAnalysis[]
  teachingDecision     TeachingDecision?
  candidateAttempts    TutorCandidateAttempt[]

  @@unique([sessionId, idempotencyKey], map: "tutor_turns_session_id_idempotency_key_key")
  @@index([topicId], map: "idx_tutor_turns_topic")
  @@index([studentMessageId], map: "idx_tutor_turns_student_message")
  @@map("tutor_turns")
}

model TutorCandidateAttempt {
  id                       String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId                   String                          @map("turn_id") @db.Uuid
  candidateAttempt         Int                             @map("candidate_attempt") @db.SmallInt
  generationOutcome        TutorCandidateGenerationOutcome @map("generation_outcome")
  generationFailureCode    String?                         @map("generation_failure_code") @db.VarChar(80)
  contentHash              String?                         @map("content_hash") @db.VarChar(64)
  provider                 String?                         @db.VarChar(80)
  model                    String?                         @db.VarChar(200)
  promptVersion            String?                         @map("prompt_version") @db.VarChar(80)
  inputTokens              Int?                            @map("input_tokens")
  outputTokens             Int?                            @map("output_tokens")
  infrastructureRetryCount Int                             @default(0) @map("infrastructure_retry_count")
  startedAt                DateTime                        @map("started_at") @db.Timestamptz(6)
  completedAt              DateTime                        @map("completed_at") @db.Timestamptz(6)
  createdAt                DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  turn         TutorTurn     @relation(fields: [turnId], references: [id], onDelete: Restrict)
  guardResults GuardResult[]

  @@unique([turnId, candidateAttempt], map: "tutor_candidate_attempts_turn_attempt_key")
  @@index([turnId], map: "idx_tutor_candidate_attempts_turn")
  @@map("tutor_candidate_attempts")
}

model GuardResult {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId                  String                 @map("turn_id") @db.Uuid
  candidateAttempt        Int                    @map("candidate_attempt") @db.SmallInt
  validationStage         GuardValidationStage   @map("validation_stage")
  approved                Boolean
  violations              Json
  maximumSeverity         String?                @map("maximum_severity") @db.VarChar(16)
  recommendedAction       GuardRecommendedAction @map("recommended_action")
  provider                String?                @db.VarChar(80)
  model                   String?                @db.VarChar(200)
  promptVersion           String?                @map("prompt_version") @db.VarChar(80)
  validationPolicyVersion String                 @map("validation_policy_version") @db.VarChar(80)
  teachingPolicyVersion   String                 @map("teaching_policy_version") @db.VarChar(80)
  disclosurePolicyVersion String                 @map("disclosure_policy_version") @db.VarChar(80)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  candidate TutorCandidateAttempt @relation(fields: [turnId, candidateAttempt], references: [turnId, candidateAttempt], onDelete: Restrict)

  @@unique([turnId, candidateAttempt, validationStage], map: "guard_results_turn_attempt_stage_key")
  @@index([turnId], map: "idx_guard_results_turn")
  @@map("guard_results")
}

model Message {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId               String                @map("session_id") @db.Uuid
  turnId                  String?               @map("turn_id") @db.Uuid
  topicId                 String?               @map("topic_id") @db.Uuid
  sequence                Int
  role                    MessageRole
  authorUserId            String?               @map("author_user_id") @db.Uuid
  responseToMessageId     String?               @unique(map: "messages_response_to_message_id_key") @map("response_to_message_id") @db.Uuid
  content                 String                @db.Text
  status                  MessageStatus
  requestKind             MessageRequestKind?   @map("request_kind")
  guidanceLabel           MessageGuidanceLabel? @map("guidance_label")
  hintLevel               Int?                  @map("hint_level") @db.SmallInt
  provider                String?               @db.VarChar(80)
  model                   String?               @db.VarChar(120)
  promptVersion           String?               @map("prompt_version") @db.VarChar(80)
  inputTokens             Int?                  @map("input_tokens")
  outputTokens            Int?                  @map("output_tokens")
  errorCode               String?               @map("error_code") @db.VarChar(80)
  errorMessage            String?               @map("error_message") @db.Text
  groundingAttemptId      String?               @map("grounding_attempt_id") @db.Uuid
  groundingLeaseExpiresAt DateTime?             @map("grounding_lease_expires_at") @db.Timestamptz(6)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt             DateTime?             @map("completed_at") @db.Timestamptz(6)

  session                          ChatSession                        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  turn                             TutorTurn?                         @relation("MessageTurn", fields: [turnId], references: [id], onDelete: SetNull)
  topic                            Topic?                             @relation("MessageTopic", fields: [topicId], references: [id], onDelete: SetNull)
  author                           User?                              @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  responseToMessage                Message?                           @relation("MessageResponse", fields: [responseToMessageId], references: [id], onDelete: SetNull)
  response                         Message?                           @relation("MessageResponse")
  retrievals                       MessageRetrieval[]
  citations                        MessageCitation[]
  studentTutorTurns                TutorTurn[]                        @relation("TutorTurnStudentMessage")
  approvedTutorTurn                TutorTurn?                         @relation("TutorTurnApprovedTutorMessage")
  educationalAnalyses              EducationalAnalysis[]              @relation("EducationalAnalysisStudentMessage")
  educationalAnalysisEvidenceLinks EducationalAnalysisEvidenceLink[]
  misconceptionAnalysisEvidence    EducationalAnalysisMisconception[] @relation("EducationalAnalysisMisconceptionEvidence")
  reviewCase                       ReviewCase?

  @@unique([sessionId, sequence], map: "messages_session_id_sequence_key")
  @@index([turnId], map: "idx_messages_turn")
  @@index([topicId], map: "idx_messages_topic")
  @@index([authorUserId], map: "idx_messages_author")
  @@index([sessionId, status, groundingLeaseExpiresAt], map: "idx_messages_grounding_lease")
  @@map("messages")
}

model EducationalAnalysis {
  id                                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId                             String             @map("turn_id") @db.Uuid
  topicId                            String             @map("topic_id") @db.Uuid
  studentMessageId                   String             @map("student_message_id") @db.Uuid
  attempt                            Int                @default(1)
  requestKind                        MessageRequestKind @map("request_kind")
  studentState                       StudentState       @map("student_state")
  effortPresent                      Boolean            @map("effort_present")
  effortQuality                      String             @map("effort_quality") @db.VarChar(20)
  effortType                         String?            @map("effort_type") @db.VarChar(40)
  effortAddressesPreviousTutorAction Boolean            @map("effort_addresses_previous_tutor_action")
  effortIsRepeated                   Boolean            @map("effort_is_repeated")
  learningEvidencePresent            Boolean            @map("learning_evidence_present")
  learningEvidenceStrength           String             @map("learning_evidence_strength") @db.VarChar(20)
  topicRelation                      String             @map("topic_relation") @db.VarChar(40)
  recommendedStrategy                TeachingStrategy   @map("recommended_strategy")
  recommendedTechnique               TeachingTechnique  @map("recommended_technique")
  recommendedGuidanceLevel           Int                @map("recommended_guidance_level") @db.SmallInt
  confidence                         Float
  provider                           String             @db.VarChar(80)
  model                              String             @db.VarChar(200)
  modelVersion                       String?            @map("model_version") @db.VarChar(200)
  promptVersion                      String             @map("prompt_version") @db.VarChar(80)
  schemaVersion                      String             @map("schema_version") @db.VarChar(80)
  inputTokens                        Int?               @map("input_tokens")
  outputTokens                       Int?               @map("output_tokens")
  latencyMs                          Int?               @map("latency_ms")
  analysisSource                     String             @default("model") @map("analysis_source") @db.VarChar(40)
  fallbackReason                     String?            @map("fallback_reason") @db.VarChar(80)
  failureCategory                    String?            @map("failure_category") @db.VarChar(120)
  confidencePolicyVersion            String?            @map("confidence_policy_version") @db.VarChar(120)
  infrastructureRetryCount           Int                @default(0) @map("infrastructure_retry_count")
  createdAt                          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  turn             TutorTurn                          @relation(fields: [turnId], references: [id], onDelete: Restrict)
  topic            Topic                              @relation(fields: [topicId], references: [id], onDelete: Restrict)
  studentMessage   Message                            @relation("EducationalAnalysisStudentMessage", fields: [studentMessageId], references: [id], onDelete: Restrict)
  evidenceLinks    EducationalAnalysisEvidenceLink[]
  misconceptions   EducationalAnalysisMisconception[]
  teachingDecision TeachingDecision?

  @@unique([turnId, attempt], map: "educational_analyses_turn_id_attempt_key")
  @@index([topicId, createdAt], map: "idx_educational_analyses_topic_created")
  @@index([studentMessageId], map: "idx_educational_analyses_student_message")
  @@map("educational_analyses")
}

model TeachingDecision {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId               String             @unique(map: "teaching_decisions_turn_id_key") @map("turn_id") @db.Uuid
  topicId              String             @map("topic_id") @db.Uuid
  analysisId           String             @unique(map: "teaching_decisions_analysis_id_key") @map("analysis_id") @db.Uuid
  strategy             TeachingStrategy
  primaryTechnique     TeachingTechnique  @map("primary_technique")
  supportingTechnique  TeachingTechnique? @map("supporting_technique")
  guidanceLevel        Int                @map("guidance_level") @db.SmallInt
  revealPolicy         RevealPolicy       @map("reveal_policy")
  reflectionMode       ReflectionMode     @map("reflection_mode")
  requireStudentAction Boolean            @map("require_student_action")
  guardPolicy          Json               @map("guard_policy")
  decisionReason       String             @map("decision_reason") @db.VarChar(240)
  policyVersion        String             @map("policy_version") @db.VarChar(80)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  turn     TutorTurn           @relation(fields: [turnId], references: [id], onDelete: Restrict)
  topic    Topic               @relation(fields: [topicId], references: [id], onDelete: Restrict)
  analysis EducationalAnalysis @relation(fields: [analysisId], references: [id], onDelete: Restrict)

  @@index([topicId, createdAt], map: "idx_teaching_decisions_topic_created")
  @@index([policyVersion], map: "idx_teaching_decisions_policy_version")
  @@map("teaching_decisions")
}

model EducationalAnalysisEvidenceLink {
  id         String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId String                          @map("analysis_id") @db.Uuid
  messageId  String                          @map("message_id") @db.Uuid
  kind       EducationalAnalysisEvidenceKind
  ordinal    Int
  createdAt  DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  analysis EducationalAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  message  Message             @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@unique([analysisId, kind, ordinal], map: "educational_analysis_evidence_links_analysis_kind_ordinal_key")
  @@index([messageId], map: "idx_educational_analysis_evidence_links_message")
  @@map("educational_analysis_evidence_links")
}

model EducationalAnalysisMisconception {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId        String   @map("analysis_id") @db.Uuid
  code              String   @db.VarChar(64)
  description       String   @db.Text
  confidence        Float
  evidenceMessageId String   @map("evidence_message_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  analysis        EducationalAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  evidenceMessage Message             @relation("EducationalAnalysisMisconceptionEvidence", fields: [evidenceMessageId], references: [id], onDelete: Restrict)

  @@index([analysisId], map: "idx_educational_analysis_misconceptions_analysis")
  @@index([evidenceMessageId], map: "idx_educational_analysis_misconceptions_evidence")
  @@map("educational_analysis_misconceptions")
}

model MessageRetrieval {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId       String   @map("message_id") @db.Uuid
  chunkId         String?  @map("chunk_id") @db.Uuid
  rank            Int
  /// Raw cosine similarity (1 - cosine distance); range [-1, 1]. Enforced by the
  /// message_retrievals_similarity_score_check constraint in the migration.
  similarityScore Decimal? @map("similarity_score") @db.Decimal(8, 6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk   MaterialChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@unique([messageId, rank], map: "message_retrievals_message_id_rank_key")
  @@index([chunkId], map: "idx_retrievals_chunk")
  @@map("message_retrievals")
}

model MessageCitation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId     String   @map("message_id") @db.Uuid
  materialId    String   @map("material_id") @db.Uuid
  citationOrder Int      @map("citation_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([messageId, citationOrder], map: "message_citations_message_id_citation_order_key")
  @@index([materialId], map: "idx_citations_material")
  @@map("message_citations")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.Uuid
  courseId    String?  @map("course_id") @db.Uuid
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent") @db.Text
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([courseId, createdAt], map: "idx_audit_course_created")
  @@index([actorUserId, createdAt], map: "idx_audit_actor_created")
  @@map("audit_logs")
}
